// Jenkinsfile (Declarative) — email-notification-demo
// Demonstrates sending email notifications from a pipeline's post block.
// Requires SMTP to be configured first:
// Manage Jenkins -> System -> E-mail Notification (or Extended E-mail Notification)

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                echo 'Simulating a build step...'
                // To test the failure email path, uncomment the next line:
                // sh 'exit 1'
            }
        }
    }

    post {
        success {
            mail to: 'YOUR_EMAIL@example.com',
                 subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "Good news — the build passed.\n\nDetails: ${env.BUILD_URL}"
        }
        failure {
            mail to: 'YOUR_EMAIL@example.com',
                 subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "The build failed. Check the console output:\n${env.BUILD_URL}console"
        }
        always {
            echo 'Email notification demo pipeline finished.'
        }
    }
}

